{
  "name": "hexhaedge-backend",
  "private": true,
  "description": "HexhaEdge platform backend: Firebase Cloud Functions (Chamber rules engine, scheduled jobs, M-Pesa, notifications).",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
