# Copy to backend/.env and fill in. This file holds NO secrets.
# Secrets go in Secret Manager:  firebase functions:secrets:set NAME
#   MPESA_CONSUMER_KEY  MPESA_CONSUMER_SECRET  MPESA_PASSKEY  MPESA_CALLBACK_TOKEN
#   AT_API_KEY  WHATSAPP_TOKEN  RESEND_API_KEY  CLOUDINARY_API_SECRET
# Set any provider you are not using yet to the word: unset

APP_URL=https://your-site.pages.dev
REQUIRE_STAFF_MFA=true
ENFORCE_APP_CHECK=false

# M-Pesa (Daraja). Sandbox defaults shown. Production needs a Safaricom-issued Paybill or Till.
MPESA_ENV=sandbox
MPESA_SHORTCODE=174379
MPESA_TILL_OR_PAYBILL=paybill
MPESA_PARTY_B=
# Base URL of your deployed functions, used to build the payment callback URLs:
PAYMENTS_CALLBACK_BASE=https://africa-south1-your-firebase-project-id.cloudfunctions.net

# SMS (Africa's Talking). "sandbox" uses their test environment.
AT_USERNAME=sandbox
AT_SENDER_ID=

# WhatsApp Business Platform (Cloud API)
WHATSAPP_PHONE_ID=

# Email (Resend)
EMAIL_FROM=HexhaEdge <no-reply@your-domain.co.ke>

# Cloudinary (profile images only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

# Where failure alerts go (N-11)
ADMIN_ALERT_PHONE=
ADMIN_ALERT_EMAIL=
